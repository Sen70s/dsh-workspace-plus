{
  "name": "dsh-workspace-plus",
  "version": "0.6.1",
  "description": "DeepSeek Harness plugin with two switchable sub-features: workspace+ (label several directories inside one workspace and reference them by absolute path — the @ composer source, the row button, the workspace_dirs tool) and 通知/notice (Windows native notifications for running conversations, merged from dsh-notice). Each sub-feature is its own loader row and can be toggled on the plugin page.",
  "icon": "icon.svg",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-rc.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./notice": {
      "default": "./lib/notice/index.js"
    },
    "./notice/package.json": "./lib/notice/package.json",
    "./notice/locale/*.json": "./lib/notice/locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "node tools/verify.mjs",
    "prepublishOnly": "node tools/verify.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "workspace",
    "context-injection",
    "notification",
    "toast",
    "windows"
  ],
  "author": "Sen70s",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sen70s/dsh-workspace-plus.git"
  },
  "homepage": "https://github.com/Sen70s/dsh-workspace-plus#readme",
  "bugs": {
    "url": "https://github.com/Sen70s/dsh-workspace-plus/issues"
  }
}
